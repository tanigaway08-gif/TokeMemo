<% content_for :hide_hamburger, true %>
<h1 class="h3 mb-4">ユーザー登録</h1>
<style>
  /* --- フォーム全体のレイアウト --- */
  form {
    width: 100%;
    display: block;
  }

  .form-group {
    display: flex;
    align-items: center; 
    margin-bottom: 10px;
    width: 100%;
  }
  
  .form-group label {
    width: 160px; 
    font-weight: bold;
    text-align: right; 
    margin-right: 20px;
    white-space: nowrap;
  }

  .form-group input[type="text"],
  .form-group input[type="email"],
  .form-group input[type="password"] {
    display: block !important;
    width: 300px !important;
    min-width: 300px !important; /* 潰れるのを防止 */
    padding: 8px !important;
    box-sizing: border-box !important;
    border: 1px solid #ccc !important;
    border-radius: 4px !important;
    appearance: none !important; /* スマホ特有の縮小を防止 */
  }

  .submit-group {
    margin-top: 50px;
    text-align: left;
  }
  
  .submit-group input[type="submit"] {
    display: block;
    margin-left: 20px;
    width: 200px;
    padding: 10px;
    font-size: 16px;
    font-weight: bold;
    color: white;
    background-color: #3b82f6; 
    border: none;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
  }

  /* --- スマホ向けのレスポンシブ指定 --- */
  @media (max-width: 768px) {
    .form-group {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 20px; 
      padding-right: 20px; 
      box-sizing: border-box;
    }
    .form-group label {
      width: 100%;
      text-align: left;
      margin-bottom: 5px;
      margin-right: 0;
    }
    
    /* スマホ画面では横幅いっぱいにする */
    body form .form-group input[type="text"],
    body form .form-group input[type="email"],
    body form .form-group input[type="password"] {
      width: 100% !important; 
      max-width: 100% !important; 
    }
  }
</style>

<% if @user.errors.any? %>
  <div class="alert alert-danger">
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>



<%= form_with model: @user do |form| %>

  <div class="form-group">
      <%= form.label :name, "名前" %>
      <%= form.text_field :name, autofocus: true, autocomplete: "off" %>
  </div>

  <div class="form-group">
      <%= form.label :email, "メールアドレス" %>
      <%= form.email_field :email, autocomplete: "email" %>
  </div>

  <div class="form-group">
      <%= form.label :password, "パスワード" %>
      <%= form.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="form-group">
      <%= form.label :password_confirmation, "パスワード（確認）" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="submit-group">
      <%= form.submit "登録する" %>
  </div>
<% end %>

<div style="display: block; width: 100%; text-align: left; margin-top: 20px; white-space: nowrap; padding-left: 20px; box-sizing: border-box;">
  すでにアカウントをお持ちの方は<br>
  <%= link_to "ログインはこちら", new_user_session_path, style: "margin-top: 5px; white-space: nowrap;" %>
</div>
