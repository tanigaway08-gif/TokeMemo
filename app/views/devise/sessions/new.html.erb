
<h1 class="h3 mb-4">ログイン</h1>

<style>
/* --- 基本スタイル（PC向け：横並び） --- */
  .form-group {
    display: flex;
    align-items: center; /* 縦の中央で揃える */
    margin-bottom: 10px;
    width: 100%;
  }

  .form-group label {
    width: 140px; /* PCでのラベルの幅 */
    font-weight: bold;
    text-align: right; /* PCでは右寄せにして入力欄に近づける */
    margin-right: 20px;
  }

  .form-group input {
    width: 300px;
    padding: 8px;
    box-sizing: border-box;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  /* --- スマホ向けスタイル（画面幅768px以下の場合のみ適用） --- */
  @media (max-width: 768px) {
    .form-group {
      flex-direction: column; /* ★ここで縦並びに変更 */
      align-items: flex-start; /* 左寄せにする */
      padding-left: 20px; /* 下のボタン類と左の余白を揃える */
      margin-bottom: 10px;
    }
    
    .form-group label {
      width: 100%;
      text-align: left; /* スマホでは左寄せ */
      margin-right: 0;
      margin-bottom: 8px; /* 入力欄との間に隙間を作る */
    }
    
    .form-group input {
      width: 300px; /* 下のボタン（200px）と幅を揃える */
    }
  }
  .submit-group {
    margin-top: 40px;
    padding-left: 180px;
  }

/* ボタンを囲む枠の余白調整 */
  .submit-group,
  .guest-login-group,
  form.button_to {
    width: 100%;
    padding: 0;
    margin-top: 60px;
    text-align: left;
  }

  /* 2つのボタンの幅とデザインを完全に揃え、絶対に中央に配置する */
  .action-btn {
    display: block;     /* ★インライン要素からブロック要素に変更 */
    margin-left: 20px; 
    width: 200px;       /* ボタンの幅を統一 */
    padding: 10px;
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    background-color: #10b981; 
    border: none;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
  }
</style>

    <%= form_with url: login_path, local: true do |form| %>
        <div class="form-group">
            <%= form.label :email, "メールアドレス" %>
            <%= form.email_field :email , autofocus: true, autocomplete: "email" %>
        </div>

        <div class="form-group">
            <%= form.label :password, "パスワード" %>
            <%= form.password_field :password, autocomplete: "new-password" %>
        </div>

        <div class="submit-group">
            <%= form.submit "ログインする", class: "action-btn"%>
        </div>
    <% end %>

   <div style="display: block; width: 100%; text-align: left; margin-top: 20px; white-space: nowrap; padding-left: 20px; box-sizing: border-box;">
        アカウントをお持ちでない場合<p>
        <%= link_to "新規登録はこちら", new_user_registration_path %>
    </div>

        <div class="submit-group">
      <%# ログインしていない時に表示するエリアに追加 %>
      <%= button_to "ゲストログイン", users_guest_sign_in_path, class: "action-btn" %>
        </div>
