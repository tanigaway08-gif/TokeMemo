<% content_for :hide_hamburger, true %>
<% content_for :title, "ログイン" %>

<h1 class="h3 mb-4">ログイン</h1>

<style>
  /* --- 基本スタイル（PC向け：横並び） --- */
  .form-group {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
    width: 100%;
  }

  .form-group label {
    width: 140px;
    font-weight: bold;
    text-align: right;
    margin-right: 20px;
  }

  .form-group input {
    width: 300px;
    padding: 8px;
    box-sizing: border-box;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  /* --- ボタンエリア --- */
  .submit-group,
  .guest-login-group,
  form.button_to {
    width: 100%;
    padding: 0;
    margin-top: 60px;
    text-align: left;
  }

  .action-btn {
    display: block;
    margin-left: 20px; 
    width: 200px;
    padding: 10px;
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    background-color: #10b981; 
    border: none;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
  }

  /* --- 新規登録リンクエリア --- */
  .signup-prompt {
    display: block;
    width: 100%;
    text-align: left;
    margin-top: 20px;
    white-space: nowrap;
    padding-left: 20px;
    box-sizing: border-box;
  }

  /* --- スマホ向けスタイル（画面幅768px以下の場合のみ適用） --- */
  @media (max-width: 768px) {
    .form-group {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 20px;
      margin-bottom: 10px;
    }
    
    .form-group label {
      width: 100%;
      text-align: left;
      margin-right: 0;
      margin-bottom: 8px;
    }
    
    .form-group input {
      width: 300px;
    }
  }
</style>

<%= form_with model: @user, url: user_session_path do |form| %>
  <div class="form-group">
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="form-group">
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, autocomplete: "current-password" %>
  </div>

  <div class="submit-group">
    <%= form.submit "ログインする", class: "action-btn" %>
  </div>
<% end %>

<div class="signup-prompt">
  アカウントをお持ちでない場合<br>
  <%= link_to "新規登録はこちら", new_user_registration_path %>
</div>

<div class="submit-group">
  <%# ログインしていない時に表示するエリアに追加 %>
  <%= button_to "ゲストログイン", users_guest_sign_in_path, class: "action-btn" %>
</div>