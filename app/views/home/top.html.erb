<% content_for :hide_hamburger, true %>
<style>
  /* トップ画面のみ背景色を白にする */
  body {
    background-color: #ffffff !important;
  }
</style>

<div class="container mt-4">
  <!-- ファーストビュー（上部） -->
  <div class="row align-items-center mb-4">
    
    <!-- ========================================== -->
    <!-- 【PC用】左側ブロック（スマホでは非表示） -->
    <!-- ========================================== -->
    <div class="col-lg-6 text-center text-lg-start mb-4 mb-lg-0 d-none d-lg-block">
      <h1 class="display-5 fw-bold mb-3">TokeMemo 🐾</h1>
      <p class="lead text-muted mb-5">
        コード上で意味を持つ最小単位の文字のことをtokenといいます。このアプリは、気になったtokenをサクッとMemoして瞬時に見つけ出す。あなたのプログラミング学習を加速させるメモアプリです。
      </p>
      
      <div class="d-grid gap-3 d-sm-flex justify-content-sm-center justify-content-lg-start">
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-primary px-4" %>
        <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary px-4" %>
        <%= link_to "ゲストログイン", users_guest_sign_in_path, data: { turbo_method: :post }, class: "btn btn-success px-4" %>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 【PC用】右側ブロック：画像（スマホでは非表示） -->
    <!-- ========================================== -->
    <div class="col-lg-6 text-center d-none d-lg-block">
      <%= image_tag "dog.jpg", class: "img-fluid rounded", alt: "TokeMemoの画面イメージ", style: "max-height: 400px; object-fit: contain;" %>
    </div>


    <!-- ========================================== -->
    <!-- 【スマホ用】専用レイアウト（PCでは非表示） -->
    <!-- ========================================== -->
    <div class="col-12 text-center d-lg-none mb-4">
      <!-- 1. タイトル -->
      <h1 class="h3 fw-bold mb-3">TokeMemo 🐾</h1>
      
      <!-- 2. 文言 -->
      <p class="text-muted small mb-4 px-2 text-start">
        コード上で意味を持つ最小単位の文字のことをtokenといいます。このアプリは、気になったtokenをサクッとMemoして瞬時に見つけ出す。あなたのプログラミング学習を加速させるメモアプリです。
      </p>
      
      <!-- 3. 画像 -->
      <div class="mb-4">
        <%= image_tag "dog.jpg", class: "img-fluid", alt: "TokeMemoの画面イメージ", style: "max-height: 250px; object-fit: contain;" %>
      </div>

      <!-- 4. ボタン群（縦並び） -->
      <div class="d-grid gap-2 px-3 mb-4">
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-primary" %>
        <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary" %>
        <%= link_to "ゲストログイン", users_guest_sign_in_path, data: { turbo_method: :post }, class: "btn btn-success" %>
      </div>
    </div>

  </div>

  <!-- アプリの特徴（下部：PC・スマホ共通） -->
  <div class="row mt-2">
    <div class="col-12 text-center mb-4">
      <h3 class="fw-bold">TokeMemoの3つの特徴</h3>
    </div>
    
    <div class="col-12 col-md-4 mb-3">
      <div class="card h-100 shadow-sm border-0 bg-light">
        <div class="card-body text-center p-3">
          <h5 class="card-title fw-bold mb-2">🔍 瞬時に検索</h5>
          <p class="card-text text-muted small text-start">
            言語ごとのタグやキーワードで、過去に書いたコードや和訳をすぐに見つけ出すことができます。
          </p>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4 mb-3">
      <div class="card h-100 shadow-sm border-0 bg-light">
        <div class="card-body text-center p-3">
          <h5 class="card-title fw-bold mb-2">📝 シンプルな記録</h5>
          <p class="card-text text-muted small text-start">
            コード、和訳、メモなど、必要な情報だけを整理して保存できる無駄のないシンプルなデザインです。
          </p>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4 mb-3">
      <div class="card h-100 shadow-sm border-0 bg-light">
        <div class="card-body text-center p-3">
          <h5 class="card-title fw-bold mb-2">🚀 ゲストですぐ体験</h5>
          <p class="card-text text-muted small text-start">
            面倒な登録なしで、ボタン一つでアプリのすべての機能をすぐにお試しいただけます。
          </p>
        </div>
      </div>
    </div>
  </div>
</div>