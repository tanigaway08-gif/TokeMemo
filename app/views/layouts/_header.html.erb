<!-- app/views/layouts/_header.html.erb -->

<nav class="navbar navbar-expand-lg sticky-top" style="background-color: #e8f5e9; border-bottom: 1px solid #ddd; padding-top: 20px; padding-bottom: 20px;">
  <div class="container-fluid">
    
    <!-- 左側：タイトル -->
    <%= link_to 'TokeMemo 🐾', root_path, class: 'navbar-brand fw-bold fs-2' %>

    <!-- 右側：ログイン・ログアウトボタン -->
    <!-- 修正: d-flex と align-items-center を追加して横並びを安定させます -->
    <div class="d-flex align-items-center">
      <% if user_signed_in? %>
        <!-- ▼ ログイン中の表示 ▼ -->
        <span class="me-3 fw-bold text-secondary small">
          こんにちは、<%= current_user.name %>さん
        </span>
        <!-- 修正: d-fexのタイポを修正、不要な align-self-end を削除 -->
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-danger d-flex" %>
      <% else %>
        <!-- ▼ 未ログイン時の表示 ▼ -->
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-primary me-2" %>
        <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary" %>
      <% end %>
    </div>
    
  </div> <!-- ★ 修正: この閉じタグを追加 -->
</nav>