<style>
  .custom-navbar {
    background-color: #e8f5e9;
    border-bottom: 1px solid #ddd;
    padding-top: 20px;
    padding-bottom: 20px;
  }
</style>

<nav class="navbar navbar-expand-lg sticky-top custom-navbar">
  <div class="container-fluid">
    
    <!-- 左側：タイトル -->
    <%= link_to 'TokeMemo 🐾', root_path, class: 'navbar-brand fw-bold fs-2' %>

    <!-- 右側：ユーザーメニュー -->
    <div class="d-flex align-items-center">
      <% if user_signed_in? %>
        <span class="me-3 fw-bold text-secondary small">
          こんにちは、<%= current_user.name %>さん
        </span>
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-danger" %>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-primary me-2" %>
        <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary" %>
      <% end %>
    </div>
    
  </div>
</nav>