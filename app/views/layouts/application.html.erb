<!DOCTYPE html>
<html>
  <head>
    <meta property="og:title" content="Myapp" />
    <meta property="og:description" content="プログラミング学習を加速させるメモアプリです" />

    <!-- image_urlヘルパーを使うことで、本番環境で自動的に https://... から始まる絶対URLが生成されます -->
    <meta property="og:image" content="<%= image_url('X用TokeMemo.png') %>" />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for(:title) || "Myapp" %></title>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Myapp">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>
      // 画面が切り替わるたびに色付けを再実行する
      document.addEventListener("turbo:load", function() {
        hljs.highlightAll();
      });
    </script>

    <style>
      body {
        margin: 0;
        overflow-x: hidden;
      }
      
      .dashboard-container {
        display: flex;
        min-height: 100vh;
        width: 100%;
      }

      /* ▼ フォーム用の設定 ▼ */
      .form-group {
        display: flex;
        align-items: flex-start;
        margin-bottom: 25px;
      }
      .form-group > label {
        width: 120px;
        min-width: 120px;
        font-weight: bold;
        margin-top: 5px;
      }
      .input-short {
        width: 300px;
        padding: 8px;
        box-sizing: border-box;
      }
      .input-large {
        width: 500px;
        height: 120px;
        padding: 8px;
        box-sizing: border-box;
      }
      .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 5px;
      }
      .checkbox-group label {
        font-weight: normal;
        cursor: pointer;
      }

      /* ▼ サイドバーとメインコンテンツ ▼ */
      .sidebar {
        width: 250px;
        padding: 80px 40px 40px 20px;
        background-color: #f8f9fa;
        border-right: 1px solid #ddd;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
      }

      .sidebar h3 {
        text-align: left;
        width: 100%;
        margin-top: 0;
      }
      .sidebar form {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .search-group {
        margin-bottom: 40px;
        width: 100%;
        text-align: left;
      }
      .sidebar input[type="text"],
      .sidebar input[type="submit"] {
        width: 100%;
        max-width: 200px;
        box-sizing: border-box;
      }

      .main-content {
        width: calc(100% - 250px);
        padding: 30px 15px 30px 30px;
        box-sizing: border-box;
      }

      /* PC向けの基本スタイル */
      .form-container {
        width: 600px;
        margin: 0 auto;
      }

      .card-container {
        display: flex;
        flex-wrap: wrap;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      /* ========================
         PC版（デフォルト）の設定
      ======================== */
      .search-menu-btn {
        display: none; /* PCでは非表示 */
      }

      /* ========================
         スマホ向け（画面幅768px以下）の設定
      ======================== */
      @media (max-width: 768px) {
        .form-container {
          width: 100%;
          padding: 30px;
        }
        
        .main-content {
          width: 100%;
          padding: 15px;
        }
      }

      /* ========================
         スマホ版（767.98px以下）の設定
      ======================== */
      @media (max-width: 767.98px) {
        /* 「検索」テキストボタンのデザイン */
        .search-menu-btn {
          display: flex;
          justify-content: center;
          align-items: center;
          background-color: #007bff;
          color: #fff;
          font-weight: bold;
          font-size: 15px;
          border: none;
          border-radius: 30px;
          cursor: pointer;
          position: fixed;
          bottom: 600px;
          right: 20px;
          z-index: 1050;
          padding: 10px 24px;
          box-shadow: 0 4px 6px rgba(0,0,0,0.2);
          transition: background-color 0.2s;
        }

        .search-menu-btn:active {
          background-color: #0056b3;
        }

        /* サイドバーを画面外にスライドイン用のメニューに変更 */
        .sidebar {
          position: fixed;
          top: 0;
          left: -100%; /* 初期状態は画面外 */
          width: 280px;
          max-width: 80%;
          height: 100vh;
          background-color: #fff;
          box-shadow: 2px 0 5px rgba(0,0,0,0.2);
          transition: left 0.3s ease;
          z-index: 1040;
          padding: 20px;
          overflow-y: auto;
        }

        /* スライドイン時 */
        .sidebar.is-open {
          left: 0;
        }
      }
    </style>
  </head>

  <body>
    <%= render 'layouts/header' %>

    <% if notice %>
      <div class="alert alert-success text-center mb-0"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger text-center mb-0"><%= alert %></div>
    <% end %>

    <div class="dashboard-container">
      <div id="sidebar" class="sidebar col-md-3">
        <% if controller_name == 'tokens' %>
          <h3>検索</h3>
          <%= form_with url: tokens_path, method: :get, local: true do |form| %>
            <div class="search-group">
              <%= form.label :keyword, "キーワード" %><br>
              <%= form.text_field :keyword, value: params[:keyword], style: "width: 100%;" %>
            </div>

            <div class="search-group">
              <label>言語・フレームワーク</label><br>
              <div style="display: inline-block; text-align: left;">
                <%= form.check_box :lang_html, checked: params[:lang_html] == "1" %> HTML<br>
                <%= form.check_box :lang_css, checked: params[:lang_css] == "1" %> CSS<br>
                <%= form.check_box :lang_javascript, checked: params[:lang_javascript] == "1" %> JavaScript<br>
                <%= form.check_box :lang_ruby, checked: params[:lang_ruby] == "1" %> Ruby<br>
                <%= form.check_box :lang_rails, checked: params[:lang_rails] == "1" %> Rails<br>
                <%= form.check_box :lang_other, checked: params[:lang_other] == "1" %> その他
              </div>
            </div>

            <%= form.submit "検索する", style: "width: 100%; cursor: pointer;" %>
          <% end %>

          <div style="margin-top: 30px; width: 100%;">
            <%= link_to "新規登録", new_token_path, style: "display: block; margin: 0 ; max-width: 200px; text-align: center; padding: 10px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; box-sizing: border-box;" %>
          </div>
        <% end %>
      </div>

      <div class="main-content col-12 col-md-9 pe-0">
        <%= yield %>
      </div>
    </div>
  </body>
</html>