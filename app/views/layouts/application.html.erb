<!DOCTYPE html>
<html>
  <head>
    <!-- 1. メタデータ -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="TokeMemo">

    <!-- OGP (SNSシェア用) -->
    <meta property="og:title" content="TokeMemo" />
    <meta property="og:description" content="プログラミング学習を加速させるメモアプリです" />
    <meta property="og:image" content="<%= image_url('X用TokeMemo.jpg') %>" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- タイトル & Rails必須タグ -->
    <title><%= content_for(:title) ? "TokeMemo | #{yield(:title)}" : "TokeMemo" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <!-- アイコン -->
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= favicon_link_tag 'apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png' %>

    <!-- 2. スタイルシート & スクリプト -->
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>
      document.addEventListener("turbo:load", function() {
        hljs.highlightAll();
      });
    </script>

    <!-- 3. カスタムスタイル -->
    <style>
      /* ========================
         ベーススタイル
      ======================== */
      body {
        margin: 0;
      }
      img {
        max-width: 100%;
        height: auto;
      }

      /* ========================
         レイアウト (PC・iPad基本設定)
      ======================== */
      .sidebar {
        padding: 80px 20px 40px 20px;
        background-color: #f8f9fa;
        border-right: 1px solid #ddd;
        display: flex;
        flex-direction: column;
        align-items: center;

        /* サイドバー固定化（FlexboxのStretch解除を含む） */
        <%# position: sticky; %>
        position: fixed;
        top: 60px;
        height: 100vh;
        overflow-y: auto;
        align-self: flex-start;
      }

      .main-content {
        padding: 30px 15px 30px 30px;
        box-sizing: border-box;
      }

      /* ========================
         サイドバー内の要素
      ======================== */
      .sidebar h3 {
        text-align: left;
        width: 100%;
        margin-top: 0;
      }
      .sidebar form {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .search-group {
        margin-bottom: 40px;
        width: 100%;
        text-align: left;
      }
      .search-group input[type="text"],
      .sidebar-submit {
        width: 100%;
        max-width: 200px;
        box-sizing: border-box;
      }
      .sidebar-submit {
        cursor: pointer;
        margin-bottom: 30px;
      }
      .lang-checkboxes {
        display: inline-block;
        text-align: left;
      }
      .sidebar-btn-new {
        display: block;
        width: 100%;
        max-width: 200px;
        text-align: center;
        padding: 10px;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        box-sizing: border-box;
      }
      .sidebar-btn-new:hover {
        background-color: #0056b3;
      }

      /* ========================
         汎用コンポーネント (フォーム等)
      ======================== */
      .form-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
      }
      .card-container {
        display: flex;
        flex-wrap: wrap;
      }
      .form-group {
        display: flex;
        align-items: flex-start;
        margin-bottom: 25px;
      }
      .form-group > label {
        width: 120px;
        min-width: 120px;
        font-weight: bold;
        margin-top: 5px;
      }
      .input-short {
        width: 300px;
        padding: 8px;
        box-sizing: border-box;
      }
      .input-large {
        width: 500px;
        height: 120px;
        padding: 8px;
        box-sizing: border-box;
      }
      .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 5px;
      }
      .checkbox-group label {
        font-weight: normal;
        cursor: pointer;
      }

      /* ========================
         レスポンシブ (スマホ版: 767.98px以下)
      ======================== */
      @media (max-width: 767.98px) {
        .form-container {
          padding: 30px;
        }
        .main-content {
          padding: 15px;
        }

        .sidebar {
          position: fixed;
          top: 0;
          left: -100%;
          width: 280px !important;
          max-width: 80%;
          height: 100vh;
          background-color: #fff;
          box-shadow: 2px 0 5px rgba(0,0,0,0.2);
          transition: left 0.3s ease;
          z-index: 1040;
          padding: 20px;
        }
        .sidebar.is-open {
          left: 0;
        }

        .search-menu-btn {
          display: flex;
          justify-content: center;
          align-items: center;
          background-color: #007bff;
          color: #fff;
          font-weight: bold;
          font-size: 15px;
          border: none;
          border-radius: 30px;
          cursor: pointer;
          position: fixed;
          bottom: 20px;
          right: 20px;
          z-index: 1050;
          padding: 10px 24px;
          box-shadow: 0 4px 6px rgba(0,0,0,0.2);
          transition: background-color 0.2s;
        }
        .search-menu-btn:active {
          background-color: #0056b3;
        }
      }

      /* ========================
         レスポンシブ (PC・iPad版: 768px以上)
      ======================== */
      @media (min-width: 768px) {
        .search-menu-btn {
          display: none !important;
        }
      }
    </style>
  </head>

  <body>
    <%= render 'layouts/header' %>

    <% if notice %>
      <div class="alert alert-success text-center mb-0"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger text-center mb-0"><%= alert %></div>
    <% end %>

    <div class="container-fluid p-0">
      <div class="row g-0">
        
        <!-- 左側：サイドバー -->
        <div id="sidebar" class="sidebar col-md-3 col-lg-2">
          <% if controller_name == 'tokens' %>
            <h3>検索</h3>
            <%= form_with url: tokens_path, method: :get, local: true do |form| %>
              <div class="search-group">
                <%= form.label :keyword, "キーワード" %><br>
                <%= form.text_field :keyword, value: params[:keyword] %>
              </div>

              <div class="search-group">
                <label>言語・フレームワーク</label><br>
                <div class="lang-checkboxes">
                  <%= form.check_box :lang_html, checked: params[:lang_html] == "1" %> HTML<br>
                  <%= form.check_box :lang_css, checked: params[:lang_css] == "1" %> CSS<br>
                  <%= form.check_box :lang_javascript, checked: params[:lang_javascript] == "1" %> JavaScript<br>
                  <%= form.check_box :lang_ruby, checked: params[:lang_ruby] == "1" %> Ruby<br>
                  <%= form.check_box :lang_rails, checked: params[:lang_rails] == "1" %> Rails<br>
                  <%= form.check_box :lang_other, checked: params[:lang_other] == "1" %> その他
                </div>
              </div>

              <%= form.submit "検索する", class: "sidebar-submit" %>
            <% end %>

            <div style="width: 100%;">
              <%= link_to "新規登録", new_token_path, class: "sidebar-btn-new" %>
            </div>
          <% end %>
        </div>

        <!-- 右側：メインコンテンツ -->
        <div class="main-content col-12 col-md-9 offset-md-3 col-lg-10 offset-lg-2">
          <%= yield %>
        </div>

      </div>
    </div>
  </body>
</html>