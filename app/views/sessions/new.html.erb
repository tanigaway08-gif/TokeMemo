<h1>ログイン</h1>

<style>
  .form-group {
    display: flex;
    align-items: center;
    margin-bottom: 30px;
  }
  .form-group label {
    width: 160px;
    font-weight: bold;
    text-align: right;
    margin-right: 20px;
  }
  .form-group input {
    width: 250px;
    padding: 8px;
    box-sizing: border-box;
  }
  .submit-group {
    margin-top: 40px;
    padding-left: 180px;
  }

  @media (max-width: 768px) {
    .form-group {
      flex-direction: column; /* 横並びから縦並びに変更 */
      align-items: flex-start; /* 左寄せにする */
    }
    .form-group label {
      width: 100%; /* 固定幅を解除 */
      text-align: left; /* 左寄せに変更 */
      margin-right: 0;
      margin-bottom: 8px; /* 入力欄との間に余白を少し */
    }
    .form-group input {
      width: 100%; /* 入力欄を画面幅いっぱいに広げる */
    }
    .submit-group {
      padding-left: 0; /* PC用の180pxの余白を消す */
      text-align: center; /* ボタンを中央に配置 */
    }
  }
  
</style>

    <%= form_with url: tokens_path, local: true do |form| %>
        <div class="form-group">
            <%= form.label :email, "メールアドレス" %>
            <%= form.email_field :email %>
        </div>

        <div class="form-group">
            <%= form.label :password, "パスワード" %>
            <%= form.password_field :password %>
        </div>

        <div class="submit-group">
            <%= form.submit "ログインする" %>
        </div>
    <% end %>

    <div style="margin-top: 20px; text-align: center; white-space: nowrap;">
        アカウントをお持ちでない場合は
        <%= link_to "新規登録はこちら", new_user_path %>
    </div>

