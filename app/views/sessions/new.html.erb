<h1>ログイン</h1>

<style>
  .form-group {
    display: flex;
    align-items: center;
    margin-bottom: 30px;
  }
  .form-group label {
    width: 160px;
    font-weight: bold;
    text-align: right;
    margin-right: 20px;
  }
  .form-group input {
    width: 250px;
    padding: 8px;
    box-sizing: border-box;
  }
  .submit-group {
    margin-top: 40px;
    padding-left: 180px;
  }
</style>

    <%= form_with url: login_path, local: true do |form| %>
        <div class="form-group">
            <%= form.label :email, "メールアドレス" %>
            <%= form.email_field :email %>
        </div>

        <div class="form-group">
            <%= form.label :password, "パスワード" %>
            <%= form.password_field :password %>
        </div>

        <div class="submit-group">
            <%= form.submit "ログインする" %>
        </div>
    <% end %>

    <div style="margin-top: 20px; padding-left: 180px;">
        アカウントをお持ちでない場合は
        <%= link_to "新規登録はこちら", new_user_path %>
    </div>