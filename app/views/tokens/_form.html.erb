<style>
  .form-group {
    display: flex;
    align-items: flex-start;
    margin-bottom: 25px;
  }
  .form-group > label {
    width: 120px;
    min-width: 120px;
    font-weight: bold;
    margin-top: 5px;
  }
  .input-short {
    width: 300px;
    padding: 8px;
    box-sizing: border-box;
  }
  .input-large {
    width: 500px;
    height: 120px;
    padding: 8px;
    box-sizing: border-box;
  }
  .checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 5px;
  }
  .checkbox-group label {
    font-weight: normal;
    cursor: pointer;
  }

  
</style>

<%= form_with model: token, local: true do |form| %>

  <% if token.errors.any? %>
    <div style="color: red; margin-bottom: 20px;">
      <ul>
        <% token.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :code, "コード (必須)" %>
    <%= form.text_field :code, class: "input-short" %>
  </div>

  <div class="form-group">
    <%= form.label :translation, "意味・翻訳" %>
    <%= form.text_area :translation, class: "input-large" %>
  </div>

  <div class="form-group">
    <%= form.label :example, "使用例" %>
    <%= form.text_area :example, class: "input-large" %>
  </div>

  <div class="form-group">
    <%= form.label :memo, "Memo" %>
    <%= form.text_area :memo, class: "input-large" %>
  </div>

  <div class="form-group">
    <label>関連言語</label>
    <div class="checkbox-group">
      <label><%= form.check_box :lang_html %> HTML</label>
      <label><%= form.check_box :lang_css %> CSS</label>
      <label><%= form.check_box :lang_javascript %> JavaScript</label>
      <label><%= form.check_box :lang_ruby %> Ruby</label>
      <label><%= form.check_box :lang_rails %> Rails</label>
      <label><%= form.check_box :lang_other %> その他</label>
    </div>
  </div>

 <div style="margin-top: 30px; padding-left: 120px;">
    <!-- token.new_record? を使って新規か更新かを判定します -->
    <%= form.submit token.new_record? ? "登録する" : "更新する", style: "padding: 10px 20px; cursor: pointer;" %>
  </div>

<% end %>