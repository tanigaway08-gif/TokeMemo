<style>
  /* 一覧のカードデザインだけ残す */
  .result-card {
    border: 1px solid #ddd;
    padding: 12px;
    margin-bottom: 8px;
    border-radius: 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%; /* ← これを追加 */
    box-sizing: border-box; /* ← はみ出し防止のために追加 */
  }

  .btn-detail {
    display: inline-block;
    padding: 6px 12px;
    background-color: #6c757d; /* 落ち着いたグレー */
    color: white;
    text-decoration: none;
    border-radius: 4px;
    margin-right: 10px;
    font-size: 0.85em;
    transition: 0.2s;
  }
  .btn-detail:hover {
    background-color: #5a6268; /* マウスを乗せたら少し暗くする */
  }

  .btn-delete {
    display: inline-block;
    padding: 6px 12px;
    background-color: #dc3545; /* 警告を表す赤 */
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.85em;
    transition: 0.2s;
  }
  .btn-delete:hover {
    background-color: #c82333; /* マウスを乗せたら少し暗くする */
  }

.lang-badge {
    display: inline-block;
    background-color: #e2e6ea;
    color: #333;
    padding: 3px 10px;         /* 変更：上下・左右の余白を小さくしました */
    border-radius: 20px;
    font-size: 0.75em;         /* 変更：文字サイズをさらに小さくしました */
    text-decoration: none;
    white-space: nowrap;       /* 追加：タグ自体が途中で変に改行されないように保護します */
  }

  /* パソコン画面（768px以上）の時だけタイトル幅を固定する */
  @media (min-width: 768px) {
    .token-title {
      width: 300px; /* 一番長い文字が収まるように調整してください（例: 250px） */
      flex-shrink: 0;
    }
  }

<%# .pagination {
    flex-wrap: wrap;         /* 万が一はみ出た場合は折り返す */
    justify-content: center; /* 中央寄せ */
    gap: 2px;                /* ボタン同士の隙間を少し空ける */
  }

  /* ▼ 追加：ページネーションのボタン(リンク)自体を小さくする */
  .pagination .page-link {
    padding: 0.25rem 0.5rem; /* 上下・左右の余白を小さく */
    font-size: 0.75rem;      /* 文字サイズを小さく */
    border-radius: 4px;      /* 角を少し丸くする（お好みで） */
  } %>
@media (max-width: 767.98px) {
  /* ... (通常時の .search-menu-btn の設定はそのまま) ... */

  /* ▼ 修正：フラッシュメッセージ(.alert)がある時は、強制的に下げる ▼ */
  .alert ~ .search-menu-btn {
    top: 220px !important; /* !important をつけて他の設定より優先させます */
    bottom: auto !important; /* 念のため下からの固定も解除 */
  }
}

.search-menu-btn {
  position: absolute; 
  top: 150px;         
  right: 20px;        
  
  /* --- 追加：背景と枠線と影を消す --- */
  background-color: transparent; /* 背景を透明にする */
  border: none;                  /* 枠線を消す */
  box-shadow: none;              /* 影を消す */
  
  /* --- 形を固定する指定 --- */
  width: 60px;
  height: 60px;
  border-radius: 50%; /* 背景が透明なので不要になりますが、残しておいても問題ありません */
  
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

/* フラッシュメッセージが出た時だけ適用されるスタイル（そのまま） */
.search-menu-btn.has-flash {
  top: 200px; 
}
</style>

<!-- HTML部分はそのまま（完璧です！） -->
<div class="container-fluid mt-4 px-3 pe-md-5">
  <div class="row m-0">
    <div class="col-12 p-0">
      
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">一覧画面</h1>

  <% unless content_for?(:hide_hamburger) %>    
<button id="search-menu-btn" class="search-menu-btn d-md-none <%= 'has-flash' if flash.any? %>">
    <%= image_tag '検索犬.png', style: "width: 100px; height: 100px; object-fit: contain;" %>
  </button>
  <% end %>
</div>

      <% @tokens.each do |token| %>
        <div class="result-card">
          
          <!-- ▼ 修正：スマホでは縦並び(flex-column)、PCでは横並び(flex-md-row)に切り替える設定を追加 -->
          <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center flex-grow-1" style="gap: 8px; min-width: 0;">
              
              <!-- タイトル -->
              <h5 class="token-title" style="margin: 0; font-weight: bold; word-break: break-all;">
                <%= token.code %>
              </h5>
              
              <!-- タグ群 -->
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <% if token.lang_html %><span class="lang-badge">HTML</span><% end %>
                <% if token.lang_css %><span class="lang-badge">CSS</span><% end %>
                <% if token.lang_javascript %><span class="lang-badge">JavaScript</span><% end %>
                <% if token.lang_ruby %><span class="lang-badge">Ruby</span><% end %>
                <% if token.lang_rails %><span class="lang-badge">Rails</span><% end %>
                <% if token.lang_other %><span class="lang-badge">その他</span><% end %>
              </div>
          </div>

          <!-- リンクにクラス（class）を適用してボタン化 -->
          <div style="display: flex; flex-shrink: 0;">
            <%= link_to "詳細", token_path(token), class: "btn-detail" %>
            <%= link_to "削除", token_path(token), 
                data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, 
                class: "btn-delete" %>
          </div>
        </div>
      <% end %>

      <div class="mt-4 d-flex justify-content-center">
        <%= paginate @tokens, window: 0 %>
      </div>

    </div>
  </div>
</div>